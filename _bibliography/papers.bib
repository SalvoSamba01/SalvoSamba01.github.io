@inproceedings{guarnera2026aadd,
  abbr={ACM MM},
  title={Adversarial Attacks on Deepfake Detectors: A Challenge in the Era of AI-Generated Media},
  author={Guarnera, Francesco and Guarnera, Luca and Montibeller, Andrea and Sambataro, Salvatore Alfio and Pishvai, Dario Samuele and Beritelli, Ludovica and Puglisi, Giovanni and Akhtar, Zahid and Boato, Giulia and Battiato, Sebastiano},
  booktitle={Proceedings of the 34th ACM International Conference on Multimedia (MM '26)},
  address={Rio de Janeiro, Brazil},
  publisher={ACM},
  year={2026},
  doi={10.1145/3767308.3837702},
  abstract={The increasing realism of AI-generated media and its widespread dissemination through social media demand deepfake detectors that remain reliable under adversarial attacks and realistic post-processing. We present AADD-2026, a competitive benchmark for evaluating adversarial attacks against deepfake detectors under realistic deployment conditions. The challenge considers synthetic images from five generative families, social-media-inspired processing, JPEG and JPEG-AI compression, and eight heterogeneous detectors operating across spatial, frequency, and foundation-model representations. Ten teams submitted valid solutions, exploring latent-space, frequency-aware, ensemble, manifold-projection, and compression-aware attacks. Results show that explicitly accounting for compression and post-processing substantially improves transferability to unseen detectors. The winning approach achieves the highest attack success through a gradient-free real-face manifold projection strategy. Meanwhile, DINOv2- and SigLIP2-based detectors show substantially greater resilience than conventional architectures, highlighting a clear trade-off between attack transferability and perceptual fidelity.},
  pdf={aadd2026.pdf},
  website={https://iplab.dmi.unict.it/mfs/acm-aadd-challenge-2026/},
  preview={aadd2026.jpg},
  selected={true}
}

@inproceedings{leotta2026synthforensics,
  abbr={NeurIPS},
  title={SynthForensics: Benchmarking and Evaluating People-Centric Synthetic Video Deepfakes},
  author={Leotta†, Roberto and Sambataro†, Salvatore Alfio and Ragaglia, Claudio Vittorio and Casu, Mirko and Petralia, Yuri and Guarnera, Francesco and Guarnera, Luca and Battiato, Sebastiano},
  booktitle={Advances in Neural Information Processing Systems (NeurIPS), Evaluations \& Datasets Track},
  note={Poster. &#8224; Joint first authorship},
  year={2026},
  arxiv={2602.04939},
  abstract={The landscape of synthetic media has been irrevocably altered by text-to-video (T2V) models, whose outputs are rapidly approaching indistinguishability from reality. Critically, this technology is no longer confined to large-scale labs; the proliferation of efficient, open-source generators is democratizing the ability to create high-fidelity synthetic content on consumer-grade hardware. This makes existing face-centric and manipulation-based benchmarks obsolete. To address this urgent threat, we introduce SynthForensics, to the best of our knowledge the first human-centric benchmark for detecting purely synthetic video deepfakes. The benchmark comprises 6,815 unique videos from five architecturally distinct, state-of-the-art open-source T2V models. Its construction was underpinned by a meticulous two-stage, human-in-the-loop validation to ensure high semantic and visual quality. Each video is provided in four versions (raw, lossless, light, and heavy compression) to enable real-world robustness testing. Experiments demonstrate that state-of-the-art detectors are both fragile and exhibit limited generalization when evaluated on this new domain: we observe a mean performance drop of 29.19\% AUC, with some methods performing worse than random chance, and top models losing over 30 points under heavy compression. The paper further investigates the efficacy of training on SynthForensics as a means to mitigate these observed performance gaps, achieving robust generalization to unseen generators (93.81\% AUC), though at the cost of reduced backward compatibility with traditional manipulation-based deepfakes. The complete dataset and all generation metadata, including the specific prompts and inference parameters for every video, will be made publicly available.},
  pdf={synthforensics.pdf},
  preview={comparison.jpg},
  selected={true}
}
